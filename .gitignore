# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.env

# Databases
*.db

# Committed-by-mistake guards
backend/venv/

# Build output (regenerated by CI on every deploy). Anchored to the top
# level (2026-10-26): unanchored, "app/" also matched ios/App/ on a
# case-insensitive Mac, so any new file there was silently untracked.
/app/

# Output of `npx cap sync ios`, plus one hand-made copy. The Siri
# intent's source is native/ios/AddCardIntent.swift (tracked); the copy
# in ios/App/App is ignored, so an edit made to it in Xcode is NOT
# tracked. Edit native/ios, then copy it across (identical 2026-10-26).
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/App/App/AddCardIntent.swift
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
ios/App/CapApp-SPM/.swiftpm/

# Native build output (regenerated by npm run build:native)
dist-native/

# Xcode archive/export output (regenerated by the archive pipeline, docs/AMBER-XCODE.md)
build/

# Android signing (never commit)
*.keystore

# App Store Connect API keys — NEVER in the repo (see docs/AMBER-XCODE.md)
*.p8

# Other secret-shaped files (2026-10-26, cross-pollination brief: a deny
# list must cover the files that actually turn up, not only the expected
# names). The Todoist token and the .p8 live outside the repo; these
# catch a copy. Not a bare *token*: that would hide a design-tokens file.
*.pem
*.key
*-token
*_token
*.token
secrets.*
*credentials*.json

# Vite dev-server scratch
vite.config.ts.timestamp-*
inbox/
*.backup.json
